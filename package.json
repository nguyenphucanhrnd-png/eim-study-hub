{
  "name": "eim-study-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:bank && npm run validate:diagrams",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:bank": "tsx --tsconfig tsconfig.node.json scripts/validate-bank.ts",
    "build:exams": "tsx --tsconfig tsconfig.node.json scripts/build-exams.ts",
    "report:bank": "tsx --tsconfig tsconfig.node.json scripts/bank-report.ts",
    "fixture:bank": "tsx --tsconfig tsconfig.node.json scripts/gen-fixture-bank.ts",
    "review:bank": "tsx --tsconfig tsconfig.node.json scripts/export-review.ts",
    "validate:diagrams": "tsx --tsconfig tsconfig.node.json scripts/validate-diagrams.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@supabase/supabase-js": "^2.117.2",
    "motion": "^14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
